    <route id="order-consumer-route">
      <from uri="jms:queue:orders.in?concurrentConsumers=5&amp;transacted=true"/>
      <setProperty name="messageId"><simple>${header.Idempotency-Key}</simple></setProperty>

      <doTry>
        <choice>
          <when>
            <simple>${body} == null || ${body} == ''</simple>
            <throwException exceptionType="java.lang.IllegalArgumentException" message="Payload body cannot be empty"/>
          </when>
          <otherwise>
            <unmarshal>
              <json library="Jackson" unmarshalType="com.example.orderapp.model.OrderRequest"/>
            </unmarshal>

            <choice>
              <when>
                <simple>${body.orderNumber} == null || ${body.orderNumber} == ''</simple>
                <throwException exceptionType="java.lang.IllegalArgumentException" message="orderNumber is required"/>
              </when>
              <otherwise>
                <bean ref="orderTransactionService" method="process(${exchangeProperty.messageId}, ${body})"/>
              </otherwise>
            </choice>

            <marshal><json library="Jackson"/></marshal>
            <to uri="jms:queue:orders.processed?transacted=true"/>
          </otherwise>
        </choice>

        <doCatch>
          <exception>com.example.orderapp.service.OrderTransactionService$DuplicateMessageException</exception>
          <log message="Duplicate ignored: ${exchangeProperty.messageId}"/>
          <setBody>
            <simple>{"status":"DUPLICATE","messageKey":"${exchangeProperty.messageId}"}</simple>
          </setBody>
        </doCatch>
        <doCatch>
          <exception>java.lang.IllegalArgumentException</exception>
          <log message="Validation failure: ${exception.message}"/>
          <setBody>
            <simple>{"status":"INVALID","message":"${exception.message}"}</simple>
          </setBody>
        </doCatch>
      </doTry>
    </route>

  </camelContext>
</beans>