<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
          http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
          http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

  <camelContext id="orderCamelContext" xmlns="http://camel.apache.org/schema/spring">

    <!-- Global exception handling -->
    <onException>
      <exception>java.lang.Exception</exception>
      <redeliveryPolicy maximumRedeliveries="3" redeliveryDelay="2000"/>
      <handled>
        <constant>true</constant>
      </handled>
      <to uri="jms:queue:orders.dlq"/>
    </onException>

    <!-- Producer route -->
    <route id="producer-route">
      <from uri="direct:orderProducer"/>
      <marshal><json library="Jackson"/></marshal>
      <setProperty name="receivedAt">
        <simple>${date:now:yyyy-MM-dd'T'HH:mm:ss.SSS}</simple>
      </setProperty>

      <!-- Convert body to String using transform -->
      <transform>
        <simple>${body}</simple>
      </transform>
      <log message="Received message with ID ${header.Idempotency-Key}: ${body}"/>

      <to uri="jms:queue:orders.in?jmsMessageType=Text"/>
    </route>

    <!-- Consumer route -->

